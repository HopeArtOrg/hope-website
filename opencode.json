{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".github/COMMIT_CONVENTION.md",
    ".github/CONTRIBUTING.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "formatter": {
    "prettier": {
      "disabled": true
    },
    "eslint": {
      "command": ["pnpm", "eslint", "--fix", "$FILE"],
      "extensions": [".js", ".ts", ".jsx", ".tsx", ".svelte", ".astro"]
    }
  }
}
