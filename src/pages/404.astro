---
import { NotFound } from "@/components/not-found";
import { getLangFromUrl, getLocalePath, useTranslations } from "@/i18n/utils";
import BaseLayout from "@/layouts/base-layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = getLocalePath(lang, "/");
---

<BaseLayout title={t("404.title")}>
  <script is:inline>
    const pathname = window.location.pathname;
    if (pathname.startsWith("/en/") && !pathname.includes("/404")) {
      window.location.replace("/en/404");
    }
  </script>
  <NotFound
    homeHref={homeHref}
    heading={t("404.heading")}
    description={t("404.description")}
    homeLabel={t("404.backToHome")}
    client:load
  />
</BaseLayout>
