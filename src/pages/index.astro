---
import { AboutSection } from "@/components/landing/about";
import { AuthorSection } from "@/components/landing/author";
import { DemoSection } from "@/components/landing/demo";
import { HeroSection } from "@/components/landing/hero-section";
import { MessageAnimationSection } from "@/components/landing/message-animation";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import BaseLayout from "@/layouts/base-layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout>
  <HeroSection
    lang={lang}
    client:load
  />
  <AboutSection
    lang={lang}
    client:visible
  />
  <MessageAnimationSection
    label={t("messageAnimation.label")}
    client:visible
  />
  <DemoSection
    lang={lang}
    client:visible
  />
  <AuthorSection
    lang={lang}
    client:idle
  />
</BaseLayout>
