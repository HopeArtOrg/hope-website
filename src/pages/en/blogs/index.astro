---
import { Icon } from "@iconify/svelte";
import { getCollection, render } from "astro:content";

import { getLangFromUrl, getLocalePath, useTranslations } from "@/i18n/utils";
import BlogLayout from "@/layouts/blog-layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const blogNavLinks = [
  { label: t("nav.download"), href: getLocalePath(lang, "/"), icon: "lucide:download" },
  { label: t("nav.home"), href: getLocalePath(lang, "/blogs"), icon: "lucide:home" },
  { label: t("nav.rss"), href: "/rss.xml", icon: "lucide:rss" },
];

const posts = await Promise.all(
  (await getCollection("enBlog"))
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
    .map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);

      return {
        ...post,
        readingTime: remarkPluginFrontmatter.readingTimeInMin,
      };
    }),
);
---

<BlogLayout links={blogNavLinks} title={t("blog.heading")} description={t("blog.description")}>
  <div class=":uno: py-24 sm:py-32">
    <div class=":uno: mx-auto px-6 max-w-[720px]">
      <header class=":uno: mb-24 text-left">
        <h1 class=":uno: text-5xl text-foreground tracking-tighter font-bold font-primary sm:text-7xl">
          {t("blog.heading")}
        </h1>
        <p class=":uno: text-xl text-muted-foreground leading-8 mt-6 max-w-xl">
          {t("blog.description")}
        </p>
      </header>

      <div class=":uno: flex flex-col gap-12 sm:gap-16">
        {
          posts.map(post => (
            <article class=":uno: post-entry opacity-0 translate-y-8 relative group">
              <a
                href={getLocalePath(lang, `/blogs/${post.id}`)}
                class=":uno: p-8 rounded-2xl block transition-all duration-500 -mx-8 hover:bg-primary/5 hover:shadow-[0_0_40px_-10px_rgba(var(--un-primary),0.1)]"
              >
                <div class=":uno: flex flex-col gap-4">
                  <div class=":uno: text-xs text-muted-foreground/60 tracking-widest font-medium flex gap-4 uppercase items-center">
                    <time datetime={post.data.publishDate.toISOString()}>
                      {post.data.publishDate.toLocaleDateString(lang, {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                    <span class=":uno: rounded-full bg-border h-1 w-1" />
                    <span>
                      {post.readingTime} {t("blog.minRead")}
                    </span>
                  </div>

                  <div class=":uno: pr-12 relative">
                    <h2 class=":uno: text-3xl text-foreground font-bold font-primary transition-colors duration-300 group-hover:text-primary">
                      {post.data.title}
                    </h2>
                    <div class=":uno: text-primary opacity-0 translate-y-4 transition-all duration-500 right-0 top-0 absolute group-hover:opacity-100 -translate-x-4 group-hover:translate-x-0 group-hover:translate-y-0">
                      <Icon icon="lucide:arrow-up-right" class=":uno: h-8 w-8" />
                    </div>
                  </div>

                  <p class=":uno: text-lg text-muted-foreground/80 leading-relaxed max-w-2xl">
                    {post.data.description}
                  </p>

                  <div class=":uno: mt-4">
                    <div class=":uno: text-sm text-foreground tracking-tight font-semibold flex gap-2 transition-colors duration-300 items-center group-hover:text-primary">
                      {t("blog.readMore")}
                      <Icon
                        icon="lucide:arrow-right"
                        class=":uno: h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                      />
                    </div>
                  </div>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</BlogLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initAnimations() {
    const posts = document.querySelectorAll(".post-entry");

    posts.forEach((post) => {
      gsap.to(post, {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: post,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      });
    });
  }

  initAnimations();

  document.addEventListener("astro:after-swap", initAnimations);
</script>
