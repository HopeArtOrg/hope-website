---
import { getCollection, render } from "astro:content";

import { getLangFromUrl, getLocalePath, useTranslations } from "@/i18n/utils";
import BlogLayout from "@/layouts/blog-layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const blogNavLinks = [
  { label: t("nav.download"), href: getLocalePath(lang, "/"), icon: "lucide:download" },
  { label: t("nav.home"), href: getLocalePath(lang, "/blogs"), icon: "lucide:home" },
  { label: t("nav.rss"), href: "/rss.xml", icon: "lucide:rss" },
];

const posts = await Promise.all(
  (await getCollection("enBlog"))
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
    .map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);

      return {
        ...post,
        readingTime: remarkPluginFrontmatter.readingTimeInMin,
      };
    }),
);
---

<BlogLayout links={blogNavLinks} title={t("blog.heading")} description={t("blog.description")}>
  <div class=":uno: py-24 sm:py-32">
    <div class=":uno: mx-auto px-6 max-w-[720px]">
      <header class=":uno: mb-24 text-center">
        <h1 class=":uno: text-4xl text-foreground tracking-tight font-bold font-serif sm:text-5xl">
          {t("blog.heading")}
        </h1>
        <p class=":uno: text-lg text-muted-foreground leading-8 mt-6 italic">
          {t("blog.description")}
        </p>
      </header>

      <div class=":uno: flex flex-col gap-24 sm:gap-32">
        {
          posts.map(post => (
            <article class=":uno: post-entry opacity-0 translate-y-8">
              <div class=":uno: flex flex-col gap-4">
                <div class=":uno: text-xs text-muted-foreground/60 tracking-widest font-medium flex gap-4 uppercase items-center">
                  <time datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toLocaleDateString(lang, {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                  <span class=":uno: rounded-full bg-border h-1 w-1" />
                  <span>
                    {post.readingTime} {t("blog.minRead")}
                  </span>
                </div>

                <a href={getLocalePath(lang, `/blogs/${post.id}`)} class=":uno: inline-block group">
                  <h2 class=":uno: text-3xl text-foreground font-bold font-serif inline-block transition-colors duration-300 relative group-hover:text-primary">
                    {post.data.title}
                    <span class=":uno: bg-primary h-0.5 w-0 transition-all duration-300 left-0 absolute group-hover:w-full -bottom-1" />
                  </h2>
                </a>

                <p class=":uno: text-lg text-muted-foreground/80 leading-relaxed">
                  {post.data.description}
                </p>

                <div class=":uno: mt-2">
                  <a
                    href={getLocalePath(lang, `/blogs/${post.id}`)}
                    class=":uno: group/link text-sm text-foreground tracking-tight font-semibold flex gap-1 transition-colors duration-300 items-center hover:text-primary"
                  >
                    {t("blog.readMore")}
                    <div class=":uno: i-lucide-arrow-right h-4 w-4 transition-transform duration-300 group-hover/link:translate-x-1" />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</BlogLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initAnimations() {
    const posts = document.querySelectorAll(".post-entry");

    posts.forEach((post) => {
      gsap.to(post, {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: post,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      });
    });
  }

  initAnimations();

  document.addEventListener("astro:after-swap", initAnimations);
</script>
