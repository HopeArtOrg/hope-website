---
import { getLangFromUrl, getLocalePath, useTranslations } from "@/i18n/utils";
import BlogLayout from "@/layouts/blog-layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const blogNavLinks = [
  { label: t("nav.home"), href: getLocalePath(lang, "/"), icon: "lucide:home" },
  { label: t("nav.download"), href: getLocalePath(lang, "/#download"), icon: "lucide:download" },
  { label: t("nav.rss"), href: "/rss.xml", icon: "lucide:rss" },
];
---

<BlogLayout links={blogNavLinks}>
  <div class=":uno: py-24 sm:py-32">
    <div class=":uno: mx-auto px-6 max-w-7xl lg:px-8">
      <!-- Blank content for now -->
    </div>
  </div>
</BlogLayout>
