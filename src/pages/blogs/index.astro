---
import { getCollection, render } from "astro:content";

import { BlogPostEntry } from "@/components/blogs/blog-post-entry";
import YearDecoration from "@/components/blogs/year-decoration/index.astro";
import {
  getLangFromUrl,
  getLocalePath,
  useTranslations,
} from "@/i18n/utils";
import BlogLayout from "@/layouts/blog-layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allPosts = await Promise.all(
  (await getCollection("vnBlog"))
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
    .map(async (post) => {
      const { remarkPluginFrontmatter } = await render(post);

      return {
        ...post,
        readingTime: remarkPluginFrontmatter.readingTimeInMin,
      };
    }),
);

const groupedPosts = allPosts.reduce((acc, post) => {
  const year = post.data.publishDate.getFullYear();
  if (!acc[year])
acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof allPosts>);

const sortedYears = Object.keys(groupedPosts)
  .map(Number)
  .sort((a, b) => b - a);
---

<BlogLayout title={t("blog.heading")} description={t("blog.description")}>
  <div class="py-24 sm:py-32">
    <div class="mx-auto px-6 max-w-[720px]">
      <header class="mb-24 flex flex-col gap-8 items-start">
        <h1 class="text-7xl text-foreground leading-tight font-bold font-primary sm:text-9xl">
          {t("blog.heading")}
        </h1>
        <p class="text-xl text-muted-foreground leading-relaxed sm:text-2xl">
          {t("blog.description")}
        </p>
      </header>

      <div class="flex flex-col gap-24">
        {
          sortedYears.map((year, index) => (
            <section class="relative">
              {index !== 0 && (
                <div class="mb-24 opacity-50 flex items-center">
                  <div class="bg-border flex-1 h-px" />
                </div>
              )}
              <YearDecoration year={year} />
              <div class="flex flex-col gap-12 relative z-10 sm:gap-16">
                {groupedPosts[year].map(post => (
                  <BlogPostEntry
                    client:visible
                    id={post.id}
                    title={post.data.title}
                    description={post.data.description}
                    publishDate={post.data.publishDate}
                    readingTime={post.readingTime}
                    href={getLocalePath(lang, `/blogs/${post.id}`)}
                    lang={lang}
                    readMoreLabel={t("blog.readMore")}
                    minReadLabel={t("blog.minRead")}
                  />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</BlogLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initAnimations() {
    const posts = document.querySelectorAll(".post-entry");

    posts.forEach((post) => {
      gsap.to(post, {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: post,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      });
    });
  }

  initAnimations();

  document.addEventListener("astro:after-swap", initAnimations);
</script>
