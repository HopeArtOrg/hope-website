---
import { getLangFromUrl, getLocalePath, useTranslations } from "@/i18n/utils";
import { navLinks } from "@/lib/constants";

import Navbar from "./navbar.svelte";

type Props = {
  links?: Array<{ label: string; href: string; icon: string }>;
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homePath = getLocalePath(lang, "/");
const defaultLinks = navLinks.map(({ key, path, icon }) => ({
  label: t(key),
  href: getLocalePath(lang, path),
  icon,
}));

const { links = defaultLinks } = Astro.props;
---

<Navbar
  homePath={homePath}
  links={links}
  client:load
/>
