---
type Props = {
  year: string | number;
};

const { year } = Astro.props;
---

<div
  class="text-[24rem] text-muted-foreground/5 leading-none font-bold font-outline hidden pointer-events-none select-none absolute z-0 lg:block -left-32 -top-16 xl:-left-48"
  aria-hidden="true"
>
  {year}
</div>
