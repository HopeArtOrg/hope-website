---
import { WatermelonIcon } from "@/components/icons";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class=":uno: py-5 border-t border-border/15 bg-background/50 w-full sm:py-4">
  <div class=":uno: mx-auto px-5 flex flex-col gap-3 max-w-screen-xl items-center justify-between sm:px-6 sm:flex-row sm:gap-2">
    <p class=":uno: text-[9px] text-muted-foreground/50 leading-relaxed tracking-[0.15em] text-center uppercase sm:text-[10px] sm:tracking-[0.25em] sm:text-left">
      {t("footer.bannerText")}
    </p>
    <a
      href={t("footer.bannerCtaLink")}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        "group",
        ":uno: text-[9px] text-primary/70 tracking-[0.05em] flex gap-1.5 uppercase transition-all duration-500 items-center hover:text-primary sm:text-[11px] sm:tracking-[0.1em] sm:gap-2",
      ]}
    >
      <span class=":uno: bg-primary/20 h-px w-5 hidden transition-all duration-500 group-hover:bg-primary/40 group-hover:w-8 sm:block"></span>
      <span class=":uno: font-medium border-b border-primary/10 transition-colors group-hover:border-primary/30 sm:border-none">{t("footer.bannerCta")}</span>
      <WatermelonIcon
        client:load
        class=":uno: size-4 transition-transform duration-500 sm:size-5 group-hover:scale-110"
      />
    </a>
  </div>
</div>
