---
import "@/styles/shiki.css";
import "@/styles/prose.css";
import "@/styles/mermaid.css";
import "@/styles/katex.css";
import "katex/dist/katex.min.css";

import AuroraBackground from "@/components/aurora-animations/aurora-background.svelte";

import BlogLayout from "./blog-layout.astro";

type Props = {
  title: string;
  description: string;
  pubDate: string;
  readingTime?: string;
  ogImage?: string;
};

const {
  title,
  description,
  pubDate,
  readingTime,
  ogImage,
} = Astro.props;
---

<BlogLayout
  {title}
  {description}
  {ogImage}
>
  <div class=":uno: flex flex-col min-h-screen relative">
    <div
      id="aurora-wrapper"
      class=":uno: pointer-events-none inset-0 fixed z-0 overflow-hidden"
      style="opacity: 0;"
    >
      <AuroraBackground client:load />
    </div>

    <div class=":uno: mx-auto flex flex-col w-full max-w-screen-md items-center relative z-10 lg:py-32 sm:px-6 sm:py-24">
      <div
        id="glass-container"
        class=":uno: p-6 bg-background/60 w-full overflow-hidden backdrop-blur-2xl sm:p-12 sm:border sm:border-white/10 sm:rounded-2xl sm:shadow-2xl"
      >
        <header class=":uno: mb-12 text-center">
          <h1 class=":uno: text-4xl text-foreground tracking-tight font-bold font-mono mb-4 sm:text-5xl">
            {title}
          </h1>
          <div class=":uno: text-sm text-muted-foreground font-mono flex flex-wrap gap-4 items-center justify-center">
            <time datetime={pubDate}>{pubDate}</time>
            {readingTime && (
              <>
                <span class=":uno: text-muted-foreground/30">•</span>
                <span>{readingTime}</span>
              </>
            )}
          </div>
        </header>

        <article class=":uno: prose-zen max-w-none prose dark:prose-invert">
          <slot />
        </article>
      </div>
    </div>
  </div>
</BlogLayout>

<script>
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

import { setupMermaid } from "@/lib/mermaid";

gsap.registerPlugin(ScrollTrigger);

const tl = gsap.timeline({ delay: 0.1 });

tl.to("#aurora-wrapper", {
  opacity: 1,
  duration: 1.2,
  ease: "power2.inOut",
});

tl.from("#glass-container", {
  y: 60,
  opacity: 0,
  duration: 1,
  ease: "power4.out",
}, "-=0.6");

setupMermaid();
</script>

<style is:global>
  #glass-container {
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
</style>
