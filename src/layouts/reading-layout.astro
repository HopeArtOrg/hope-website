---
import "@/styles/shiki.css";
import "@/styles/prose.css";
import "@/styles/mermaid.css";
import "@/styles/katex.css";
import "katex/dist/katex.min.css";
import { Icon } from "astro-icon/components";

import { Button } from "@/components/ui/button";
import {
  getLangFromUrl,
  getLocalePath,
  useTranslations,
} from "@/i18n/utils";

import BlogLayout from "./blog-layout.astro";

type Props = {
  title: string;
  description: string;
  pubDate: string;
  readingTime?: string;
  ogImage?: string;
};

const {
  title,
  description,
  pubDate,
  readingTime,
  ogImage,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BlogLayout
  {title}
  {description}
  {ogImage}
  bodyClass="bg-transparent"
>
  <div class=":uno: flex flex-col min-h-screen relative">
    <canvas
      id="aurora-canvas"
      class=":uno: hidden pointer-events-none inset-0 fixed z-[-1] overflow-hidden md:block"
      style="opacity: 0;"
    ></canvas>

    <div
      id="back-button-container"
      class=":uno: opacity-0 translate-y-4 transition-all duration-300 bottom-8 left-6 fixed z-50 md:bottom-10 md:left-10"
    >
      <Button
        variant="ghost"
        href={getLocalePath(lang, "/blog")}
        class=":uno: font-mono px-5 border border-white/10 rounded-full bg-white/5 gap-2 backdrop-blur-md group"
      >
        <Icon
          name="lucide:undo-2"
          class=":uno: size-4 transition-transform duration-300 group-hover:-translate-x-1"
        />
        {t("blog.back")}
      </Button>
    </div>

    <div class=":uno: mx-auto px-4 pb-12 pt-24 flex flex-col w-full max-w-screen-md items-center relative z-10 lg:py-32 md:px-6 md:py-24">
      <div
        id="glass-container"
        class=":uno: w-full transition-all duration-300 overflow-hidden md:p-12 md:border md:border-white/10 md:rounded-2xl md:bg-white/[0.03] md:shadow-2xl md:backdrop-blur-md md:dark:bg-white/[0.01]"
      >
        <header class=":uno: mb-12 text-center">
          <h1 class=":uno: text-3xl text-foreground tracking-tight font-bold font-mono mb-6 sm:text-5xl">
            {title}
          </h1>
          <div class=":uno: text-xs text-muted-foreground tracking-widest font-mono flex flex-wrap gap-3 uppercase items-center justify-center md:text-sm md:gap-4">
            <time datetime={pubDate}>{pubDate}</time>
            {readingTime && (
              <>
                <span class=":uno: opacity-30">•</span>
                <span>{readingTime}</span>
              </>
            )}
          </div>
        </header>

        <article class=":uno: prose-zen max-w-none prose dark:prose-invert">
          <slot />
        </article>
      </div>
    </div>
  </div>
</BlogLayout>

<script>
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

import { setupAuroraBlogBg } from "@/components/aurora-animations/aurora-blog-bg";
import { setupMermaid } from "@/lib/mermaid";

gsap.registerPlugin(ScrollTrigger);

let auroraCleanup: (() => void) | undefined;

function initAurora() {
  auroraCleanup?.();
  const canvas = document.getElementById("aurora-canvas") as HTMLCanvasElement;
  if (!canvas || window.innerWidth < 768)
    return;

  auroraCleanup = setupAuroraBlogBg(canvas);

  gsap.to(canvas, {
    opacity: 1,
    duration: 1.5,
    ease: "power2.inOut",
  });
}

const tl = gsap.timeline({ delay: 0.1 });

tl.from("#glass-container", {
  y: 60,
  opacity: 0,
  duration: 1,
  ease: "power4.out",
});

function initScrollAnimations() {
  const backButton = document.getElementById("back-button-container");
  if (!backButton)
    return;

  ScrollTrigger.create({
    trigger: "#glass-container",
    start: "top +=200",
    endTrigger: "footer",
    end: "top bottom-=80",
    onEnter: () => {
      gsap.to(backButton, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: "power2.out",
      });
    },
    onLeaveBack: () => {
      gsap.to(backButton, {
        opacity: 0,
        y: 16,
        duration: 0.4,
        ease: "power2.in",
      });
    },
    onEnterBack: () => {
      gsap.to(backButton, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: "power2.out",
      });
    },
    onLeave: () => {
      gsap.to(backButton, {
        opacity: 0,
        y: 16,
        duration: 0.4,
        ease: "power2.in",
      });
    },
  });
}

document.addEventListener("astro:page-load", () => {
  initAurora();
  setupMermaid();
  initScrollAnimations();
});

initAurora();
setupMermaid();
initScrollAnimations();
</script>

<style is:global>
  #glass-container {
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
</style>
