---
import "@/styles/shiki.css";
import "@/styles/prose.css";
import "@/styles/mermaid.css";
import "@/styles/katex.css";
import "katex/dist/katex.min.css";

import BlogLayout from "./blog-layout.astro";

type Props = {
  title: string;
  description: string;
  pubDate: string;
  readingTime?: string;
  ogImage?: string;
};

const {
  title,
  description,
  pubDate,
  readingTime,
  ogImage,
} = Astro.props;
---

<BlogLayout
  {title}
  {description}
  {ogImage}
>
  <div class=":uno: flex flex-col min-h-screen relative">
    <canvas
      id="aurora-canvas"
      class=":uno: pointer-events-none inset-0 fixed z-0 overflow-hidden"
      style="opacity: 0;"
    ></canvas>

    <div class=":uno: mx-auto flex flex-col w-full max-w-screen-md items-center relative z-10 lg:py-32 md:px-6 md:py-24">
      <div
        id="glass-container"
        class=":uno: w-full transition-all duration-300 overflow-hidden md:p-12 md:border md:border-white/10 md:rounded-2xl md:bg-background/60 md:shadow-2xl md:backdrop-blur-2xl"
      >
        <header class=":uno: mb-12 px-6 text-center md:px-0">
          <h1 class=":uno: text-4xl text-foreground tracking-tight font-bold font-mono mb-4 sm:text-5xl">
            {title}
          </h1>
          <div class=":uno: text-sm text-muted-foreground font-mono flex flex-wrap gap-4 items-center justify-center">
            <time datetime={pubDate}>{pubDate}</time>
            {readingTime && (
              <>
                <span class=":uno: text-muted-foreground/30">•</span>
                <span>{readingTime}</span>
              </>
            )}
          </div>
        </header>

        <article class=":uno: prose-zen px-6 max-w-none prose md:px-0 dark:prose-invert">
          <slot />
        </article>
      </div>
    </div>
  </div>
</BlogLayout>

<script>
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

import { setupAuroraBlogBg } from "@/components/aurora-animations/aurora-blog-bg";
import { setupMermaid } from "@/lib/mermaid";

gsap.registerPlugin(ScrollTrigger);

let auroraCleanup: (() => void) | undefined;

function initAurora() {
  auroraCleanup?.();
  const canvas = document.getElementById("aurora-canvas") as HTMLCanvasElement;
  if (!canvas)
    return;

  auroraCleanup = setupAuroraBlogBg(canvas);

  gsap.to(canvas, {
    opacity: 1,
    duration: 1.5,
    ease: "power2.inOut",
  });
}

const tl = gsap.timeline({ delay: 0.1 });

tl.from("#glass-container", {
  y: 60,
  opacity: 0,
  duration: 1,
  ease: "power4.out",
});

document.addEventListener("astro:page-load", () => {
  initAurora();
  setupMermaid();
});

// Initial load for first mount
initAurora();
setupMermaid();
</script>

<style is:global>
  #glass-container {
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }
</style>
