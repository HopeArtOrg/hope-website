---
import Footer from "@/components/footer/index.astro";
import Navbar from "@/components/navbar/index.astro";
import Head from "@/components/templates/head.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  links?: Array<{ label: string; href: string; icon: string }>;
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t("site.title"),
  description = t("site.description"),
  canonical,
  ogImage,
  links,
} = Astro.props;
---

<!doctype html>
<html lang={lang} class=":uno: scroll-smooth">
  <head>
    <Head
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      locale={lang}
    />
  </head>

  <body class=":uno: text-foreground font-primary bg-background min-h-screen antialiased">
    <a
      href="#main-content"
      class=":uno: text-sm text-primary-foreground font-medium px-4 py-2 bg-primary transition-transform duration-200 left-0 top-0 fixed z-[100] -translate-y-full focus:translate-y-0"
    >
      {t("nav.skipToContent")}
    </a>
    <Navbar links={links} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
