---
import { AuroraBackground } from "@/components/aurora-animations";
import Footer from "@/components/footer/index.astro";
import Navbar from "@/components/navbar/index.astro";
import Head from "@/components/templates/head.astro";
import {
  getLangFromUrl,
  getLocalePath,
  useTranslations,
} from "@/i18n/utils";
import { cn } from "@/lib/utils";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  bodyClass?: string;
  showAurora?: boolean;
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t("site.title"),
  description = t("site.description"),
  canonical,
  ogImage,
  bodyClass = "bg-background",
  showAurora = true,
} = Astro.props;

const links = [
  { label: t("nav.download"), href: getLocalePath(lang, "/"), icon: "lucide:download" },
  { label: t("nav.home"), href: getLocalePath(lang, "/blogs"), icon: "lucide:home" },
  { label: t("nav.rss"), href: "/rss.xml", icon: "lucide:rss" },
];
---

<!doctype html>
<html lang={lang} class=":uno: scroll-smooth bg-background">
  <head>
    <Head
      {title}
      {description}
      {canonical}
      {ogImage}
      locale={lang}
    />
  </head>

  <body class={cn(":uno: text-foreground font-primary min-h-screen antialiased", bodyClass)}>
    <a
      href="#main-content"
      class=":uno: text-sm text-primary-foreground font-medium px-4 py-2 bg-primary transition-transform duration-200 left-0 top-0 fixed z-[100] -translate-y-full focus:translate-y-0"
    >
      {t("nav.skipToContent")}
    </a>

    {showAurora && (
      <div class=":uno: pointer-events-none inset-0 fixed z-0">
        <AuroraBackground client:load />
      </div>
    )}

    <Navbar {links} />
    <main id="main-content" class=":uno: relative z-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
